# Copie este arquivo para `.env.local` e cole a connection string do Neon.
# O Next.js e o Prisma (`prisma.config.ts`) leem os arquivos `.env*` na raiz do projeto.
#
# Não use o prefixo NEXT_PUBLIC_ — DATABASE_URL deve ficar só no servidor.
# Para `prisma migrate dev`, use a URL direta do Neon (host começa com `ep-`, não `-pooler`).

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Opcional. Usado para assinar o cookie de sessão do login.
# Se ficar vazio, o app usa a DATABASE_URL como fallback.
AUTH_SECRET="troque-por-um-segredo-longo"
